{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugin-atoms.com/schemas/composition-v1.json",
  "title": "plugin-atoms v1 composition",
  "description": "A plugin composition assembling interface contracts, capability declarations, permission scopes, lifecycle hooks, and trust primitives into a complete plugin definition.",
  "type": "object",
  "required": ["schema", "type", "id", "version", "name", "references"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://plugin-atoms.com/schemas/composition-v1.json"
    },
    "type": { "type": "string", "const": "plugin" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 40 },
      "uniqueItems": true
    },
    "references": {
      "type": "object",
      "required": ["interface_contract"],
      "additionalProperties": false,
      "properties": {
        "interface_contract":       { "$ref": "#/$defs/ref" },
        "capabilities":             { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true },
        "permission_scopes":        { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true },
        "lifecycle_hooks":          { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true },
        "trust_primitives":         { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["ref", "version"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^plugin-atoms://atoms/[a-z-]+/[a-z0-9-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
        }
      }
    }
  }
}
